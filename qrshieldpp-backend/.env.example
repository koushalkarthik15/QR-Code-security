# Replace this with a strong secret key for authenticating mobile/web clients
QRSHIELD_API_KEY=replace-with-a-long-random-key

# Maximum image size (default 5MB)
QRSHIELD_MAX_IMAGE_BYTES=5242880

# Relative path to the static URL model (from project root)
QRSHIELD_STATIC_MODEL_PATH=app/ml/models/static_url/random_forest_final.joblib
